---
import type { CollectionEntry } from 'astro:content'
import { formatPrice, optimizarImagen } from '../lib/site'

interface Props {
	producto: CollectionEntry<'products'>
}

const { producto } = Astro.props
const p = producto.data
const descuento =
	p.precioAntes && p.precioAntes > p.precio ? Math.round(((p.precioAntes - p.precio) / p.precioAntes) * 100) : 0
---

<article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
	<a href={`/productos/${p.slug}`} class="relative block overflow-hidden bg-graphite">
		<img
			src={optimizarImagen(p.imagen)}
			alt={p.alt}
			width="1200"
			height="1200"
			loading="lazy"
			decoding="async"
			class="aspect-square h-auto w-full object-cover transition-transform duration-500 group-hover:scale-105"
		/>
		{descuento > 0 && (
			<span class="absolute left-4 top-4 rounded-full bg-gold px-3 py-1 text-xs font-bold text-ink">
				-{descuento}%
			</span>
		)}
		{p.stock === false && (
			<span class="absolute right-4 top-4 rounded-full bg-ivory/90 px-3 py-1 text-xs font-semibold text-graphite">
				Agotado
			</span>
		)}
	</a>

	<div class="flex flex-1 flex-col p-5">
		<p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-deep">
			{p.categoria} · {p.marca}
		</p>
		<a href={`/productos/${p.slug}`} class="mt-1.5">
			<h3 class="font-serif text-lg leading-snug text-graphite transition-colors group-hover:text-gold-deep">
				{p.nombre}
			</h3>
		</a>

		<div class="mt-3">
			<p class="text-xl font-bold text-graphite">{formatPrice(p.precio)}</p>
			{p.precioAntes && (
				<p class="text-sm text-smoke line-through">{formatPrice(p.precioAntes)}</p>
			)}
		</div>

		<div class="mt-auto pt-4">
			<button
				type="button"
				class="js-add-consulta w-full rounded-full border border-graphite px-4 py-2.5 text-sm font-semibold text-graphite transition-colors hover:bg-graphite hover:text-ivory"
				data-slug={p.slug}
				data-nombre={p.nombre}
				data-precio={p.precio}
				data-url={`/productos/${p.slug}`}
				data-imagen={optimizarImagen(p.imagen)}
			>
				+ Añadir a consulta
			</button>
		</div>
	</div>
</article>