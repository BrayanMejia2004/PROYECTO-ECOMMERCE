---
/**
 * Selector flotante de consulta por WhatsApp.
 * - Recoge los productos marcados con .js-add-consulta (botón "Añadir a consulta").
 * - Guarda la lista en localStorage y abre WhatsApp con el mensaje prellenado.
 */
---

<div class="sr-only" aria-live="polite">
	Contador de productos en tu lista de consulta
</div>

<script>
	import type { ConsultaItem } from '../lib/consulta'
	import { getItems, addItem, removeItem, clearItems, buildMessage, openWhatsApp } from '../lib/consulta'

	const fab = document.getElementById('cv-fab') as HTMLButtonElement | null
	const badge = document.getElementById('cv-badge') as HTMLSpanElement | null
	const panel = document.getElementById('cv-panel') as HTMLDivElement | null
	const lista = document.getElementById('cv-lista') as HTMLDivElement | null
	const mensaje = document.getElementById('cv-mensaje') as HTMLTextAreaElement | null
	const vaciar = document.getElementById('cv-vaciar') as HTMLButtonElement | null
	const enviar = document.getElementById('cv-enviar') as HTMLButtonElement | null
	const cerrar = document.getElementById('cv-cerrar') as HTMLButtonElement | null

	function render(): void {
		const items = getItems()
		if (badge) {
			badge.textContent = String(items.length)
			badge.style.display = items.length > 0 ? 'flex' : 'none'
		}
		if (lista) {
			lista.innerHTML = items.length
				? items
						.map(
							(i, idx) => `
						<li class="flex items-center gap-3 rounded-xl border border-line bg-ivory p-2">
							<img src="${i.imagen}" alt="" width="48" height="48" class="h-12 w-12 shrink-0 rounded-lg object-cover" loading="lazy" />
							<div class="min-w-0 flex-1">
								<p class="truncate text-sm font-medium text-graphite">${i.nombre}</p>
								<p class="text-xs text-smoke">${new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(i.precio)}</p>
							</div>
							<button type="button" data-quitar="${i.slug}" aria-label="Quitar ${i.nombre}" class="flex h-7 w-7 items-center justify-center rounded-full text-smoke hover:bg-cream hover:text-gold-deep">✕</button>
						</li>
					`
						)
						.join('')
				: '<li class="px-4 py-8 text-center text-sm text-smoke">Aún no has añadido productos.<br/>Explora el catálogo y pulsa «Añadir a consulta».</li>'
		}
		if (mensaje) {
			mensaje.value = items.length ? buildMessage(items) : ''
		}
		if (vaciar) vaciar.style.display = items.length ? 'inline-flex' : 'none'
		document.querySelectorAll('.js-add-consulta').forEach((btn) => {
			const slug = (btn as HTMLElement).dataset.slug
			const activo = items.some((i) => i.slug === slug)
			;(btn as HTMLButtonElement).dataset.añadido = activo ? 'true' : 'false'
			;(btn as HTMLButtonElement).textContent = activo ? '✓ Añadido' : '+ Añadir a consulta'
		})
	}

	document.addEventListener('click', (e) => {
		const objetivo = (e.target as HTMLElement).closest('.js-add-consulta') as HTMLElement | null
		if (objetivo) {
			e.preventDefault()
			const item: ConsultaItem = {
				slug: objetivo.dataset.slug ?? '',
				nombre: objetivo.dataset.nombre ?? '',
				precio: Number(objetivo.dataset.precio ?? 0),
				url: typeof location !== 'undefined' ? new URL(objetivo.dataset.url ?? '/', location.origin).toString() : '',
				imagen: objetivo.dataset.imagen ?? '',
			}
			addItem(item)
			render()
			if (fab) fab.classList.add('cv-pulse')
			setTimeout(() => fab?.classList.remove('cv-pulse'), 400)
			return
		}

		const quitar = (e.target as HTMLElement).closest('[data-quitar]') as HTMLElement | null
		if (quitar) {
			removeItem(quitar.dataset.quitar ?? '')
			render()
		}
	})

	fab?.addEventListener('click', () => {
		const abierto = panel?.classList.contains('hidden')
		if (abierto) {
			panel?.classList.remove('hidden')
			if (getItems().length === 0) render()
		} else {
			panel?.classList.add('hidden')
			if (getItems().length === 0 && !mensaje?.value) {
				openWhatsApp('Hola CronoVisión 👋, me gustaría recibir información sobre sus productos.')
			}
		}
	})

	cerrar?.addEventListener('click', () => panel?.classList.add('hidden'))
	vaciar?.addEventListener('click', () => {
		clearItems()
		render()
	})
	enviar?.addEventListener('click', () => {
		openWhatsApp(mensaje?.value || 'Hola CronoVisión 👋')
	})

	render()
</script>

<style>
	@keyframes cv-pulse {
		0% { transform: scale(1); }
		40% { transform: scale(1.18); }
		100% { transform: scale(1); }
	}
	.cv-pulse {
		animation: cv-pulse 0.4s ease;
	}
</style>

<!-- Estructura del widget (se inserta junto a la transición de vista previa) -->
<div>
	<button
		id="cv-fab"
		type="button"
		aria-label="Abrir lista de consulta por WhatsApp"
		class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg transition-transform hover:scale-105"
	>
		<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z" />
		</svg>
		<span
			id="cv-badge"
			class="absolute -right-1 -top-1 hidden h-6 min-w-6 items-center justify-center rounded-full bg-gold px-1.5 text-xs font-bold text-ink"
			style="display: none"
		></span>
	</button>

	<div id="cv-panel" class="fixed bottom-24 right-5 z-50 hidden w-[calc(100vw-2.5rem)] max-w-sm origin-bottom-right animate-[cv-pulse_0.2s] rounded-3xl border border-line bg-white shadow-2xl">
		<div class="flex items-center justify-between rounded-t-3xl bg-graphite px-5 py-4 text-ivory">
			<p class="font-serif text-lg">Tu lista de consulta</p>
			<button id="cv-cerrar" type="button" aria-label="Cerrar" class="flex h-8 w-8 items-center justify-center rounded-full text-ivory/70 hover:bg-ivory/10">✕</button>
		</div>

		<div class="scroll-thin max-h-56 overflow-y-auto p-4">
			<ul id="cv-lista" class="space-y-2"></ul>
		</div>

		<div class="border-t border-line p-4">
			<textarea
				id="cv-mensaje"
				rows="5"
				class="w-full resize-none rounded-2xl border border-line bg-ivory p-3 text-sm text-graphite outline-none focus:border-gold"
				placeholder="Escribe tu mensaje o edita la lista antes de enviarla…"
			></textarea>
			<div class="mt-3 flex gap-2">
				<button
					id="cv-enviar"
					type="button"
					class="flex-1 rounded-full bg-[#25d366] px-4 py-2.5 text-sm font-bold text-white transition-opacity hover:opacity-90"
				>
					Enviar por WhatsApp
				</button>
				<button
					id="cv-vaciar"
					type="button"
					class="hidden rounded-full border border-line px-4 py-2.5 text-sm font-medium text-smoke transition-colors hover:border-gold-deep hover:text-gold-deep"
				>
					Vaciar
				</button>
			</div>
		</div>
	</div>
</div>