---
import { getCollection } from 'astro:content'
import type { Categoria } from '../lib/site'
import { CATEGORIAS } from '../lib/site'
import ProductCard from './ProductCard.astro'

interface Props {
	categoria: Categoria
}

const { categoria } = Astro.props
const info = CATEGORIAS.find((c) => c.key === categoria)!

const productos = (
	await getCollection('products', ({ data }) => data.activo && data.categoria === categoria)
).sort((a, b) => Number(b.data.destacado) - Number(a.data.destacado))

// Categorías internas del catálogo según la subcategoría/marca de cada producto
const subcategorias = [...new Set(productos.map((p) => p.data.subcategoria).filter(Boolean))]
const filtros = [{ clave: 'todas', nombre: 'Todas' }, ...subcategorias.map((s) => ({ clave: s, nombre: s }))]
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
	<nav class="text-xs text-smoke" aria-label="Ruta de navegación">
		<a href="/" class="hover:text-gold-deep">Inicio</a>
		<span class="mx-2">/</span>
		<span class="text-graphite">{info.nombre}</span>
	</nav>

	<header class="mt-6 max-w-2xl">
		<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold-deep">{info.nombre}</p>
		<h1 class="mt-2 font-serif text-4xl text-graphite sm:text-5xl">{info.descripcion}</h1>
		<p class="mt-4 text-sm text-smoke">
			{productos.length} producto{productos.length === 1 ? '' : 's'} disponibles — precios en pesos colombianos.
		</p>
	</header>

	{
		filtros.length > 1 && (
			<div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
				{filtros.map((f) => (
					<button
						type="button"
						data-filtro={f.clave}
						class:list={[
							'js-filtro rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] transition-colors',
							f.clave === 'todas'
								? 'border-graphite bg-graphite text-ivory'
								: 'border-line bg-white text-graphite hover:border-gold-deep hover:text-gold-deep',
						]}
					>
						{f.nombre}
					</button>
				))}
			</div>
		)
	}

	{
		productos.length > 0 ? (
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{productos.map((p) => (
					<div class="flex" data-categoria={p.data.subcategoria || 'sin-categoria'}>
						<ProductCard producto={p} />
					</div>
				))}
			</div>
		) : (
			<div class="mt-12 rounded-3xl border border-line bg-white p-16 text-center">
				<p class="font-serif text-2xl text-graphite">Próximamente</p>
				<p class="mt-2 text-sm text-smoke">
					Estamos renovando el catálogo de {info.nombre.toLowerCase()}. Escríbenos por WhatsApp para conocer la colección.
				</p>
			</div>
		)
	}
</section>

<script>
	const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'))
	const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('[data-categoria]'))

	botones.forEach((boton) => {
		boton.addEventListener('click', () => {
			const clave = boton.dataset.filtro ?? 'todas'

			botones.forEach((b) => {
				const activo = b === boton
				b.classList.toggle('border-graphite', activo)
				b.classList.toggle('bg-graphite', activo)
				b.classList.toggle('text-ivory', activo)
				b.classList.toggle('border-line', !activo)
				b.classList.toggle('bg-white', !activo)
				b.classList.toggle('text-graphite', !activo)
			})

			tarjetas.forEach((tarjeta) => {
				const pertenece = clave === 'todas' || tarjeta.dataset.categoria === clave
				tarjeta.classList.toggle('hidden', !pertenece)
			})
		})
	})
</script>