---
import Logotipo from './Logotipo.astro'

const enlaces = [
	{ href: '/', label: 'Inicio' },
	{ href: '/relojes', label: 'Relojes' },
	{ href: '/nosotros', label: 'Nosotros' },
	{ href: '/contacto', label: 'Contacto' },
]

const actual = Astro.url.pathname
---

<header class="sticky top-0 z-40 border-b border-line bg-ivory/90 backdrop-blur-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3.5 sm:px-6">
		<a href="/" class="flex items-center gap-3" aria-label="CronoVisión — inicio">
			<Logotipo size={34} />
			<span class="font-serif text-2xl font-semibold tracking-tight text-graphite">
				Crono<span class="text-gold">Visión</span>
			</span>
		</a>

		<nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
			{
				enlaces.map((e) => (
					<a
						href={e.href}
						class:list={[
							'text-sm font-medium tracking-wide transition-colors',
							actual === e.href || (e.href !== '/' && actual.startsWith(e.href))
								? 'text-gold-deep'
								: 'text-graphite hover:text-gold-deep',
						]}
					>
						{e.label}
					</a>
				))
			}
		</nav>

		<a
			href="/contacto"
			class="hidden rounded-full bg-graphite px-5 py-2.5 text-sm font-semibold text-ivory transition-colors hover:bg-gold-deep md:block"
		>
			Comprar ahora
		</a>

		<details class="group relative md:hidden">
			<summary
				class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line text-graphite"
				aria-label="Abrir menú"
			>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M4 7h16M4 12h16M4 17h16" class="transition group-open:opacity-0" />
					<path d="M6 6l12 12M18 6L6 18" class="hidden transition group-open:block" />
				</svg>
			</summary>
			<div class="absolute right-0 mt-3 w-52 rounded-2xl border border-line bg-ivory p-2 shadow-xl">
				{
					enlaces.map((e) => (
						<a
							href={e.href}
							class="block rounded-lg px-4 py-2.5 text-sm font-medium text-graphite hover:bg-cream hover:text-gold-deep"
						>
							{e.label}
						</a>
					))
				}
			</div>
		</details>
	</div>
</header>