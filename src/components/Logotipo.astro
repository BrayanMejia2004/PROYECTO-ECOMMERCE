---
interface Props {
	size?: number
	class?: string
}

const { size = 36, class: className = '' } = Astro.props
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<circle cx="32" cy="32" r="30" stroke="#c9a227" stroke-width="3.5" />
	<circle cx="32" cy="32" r="12" fill="#c9a227" />
	<circle cx="32" cy="32" r="4" fill="#0e0e0e" />
	<path d="M32 32L32 20" stroke="#0e0e0e" stroke-width="3" stroke-linecap="round" />
	<path d="M32 32L41 36" stroke="#0e0e0e" stroke-width="3" stroke-linecap="round" />
</svg>