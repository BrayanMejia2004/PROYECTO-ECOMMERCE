---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Página no encontrada" description="Lo sentimos, no encontramos lo que buscas." canonical="/404">
	<section class="mx-auto max-w-2xl px-4 py-28 text-center sm:px-6">
		<p class="font-serif text-7xl italic text-gold/50">404</p>
		<h1 class="mt-4 font-serif text-3xl text-graphite">Esta página no existe</h1>
		<p class="mt-3 text-sm text-smoke">
			Lo sentimos, el enlace que seguiste no lleva a ningún producto. ¿Vamos a casa?
		</p>
		<a
			href="/"
			class="mt-8 inline-block rounded-full bg-graphite px-8 py-3.5 text-sm font-bold text-ivory hover:bg-gold-deep"
		>
			Volver al inicio
		</a>
	</section>
</Layout>