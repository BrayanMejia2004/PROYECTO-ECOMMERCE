---
import Layout from '../../layouts/Layout.astro'

const articulos = [
	{
		slug: 'relojes-poedagar-opiniones-colombia',
		titulo: '¿Los Relojes Poedagar Valen la Pena? Opiniones, Calidad y Precios en Colombia',
		descripcion:
			'Analizamos a fondo los relojes Poedagar: maquinaria de cuarzo, materiales de caja, resistencia al agua y relación calidad-precio en el mercado colombiano.',
		fecha: '2026-09-19',
		lectura: '5 min de lectura',
		categoria: 'Reseñas & Opiniones',
		imagen: '/imagenes/productos/reloj-poedagar-GRISDORADONEGRO.webp',
	},
]
---

<Layout
	title="Guías y Consejos sobre Relojes en Colombia | CronoVisión"
	description="Aprende a elegir, comparar y verificar tus relojes. Análisis detallados de marcas como Poedagar y JoeFox, guías de tallas y consejos de compra en Colombia."
>
	<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
		<nav class="text-xs text-graphite/70" aria-label="Ruta de navegación">
			<a href="/" class="hover:text-gold-deep">Inicio</a>
			<span class="mx-2">/</span>
			<span class="text-graphite">Guías & Artículos</span>
		</nav>

		<header class="mt-6 max-w-3xl">
			<p class="text-xs font-bold uppercase tracking-[0.25em] text-gold-deep">Centro de Conocimiento Horológico</p>
			<h1 class="mt-3 font-serif text-4xl font-bold text-graphite sm:text-5xl">
				Guías, Reseñas y Criterios de Selección
			</h1>
			<p class="mt-4 text-base leading-relaxed text-graphite/70">
				Información honesta y sin adornos sobre maquinaria, calibres y acabados para ayudarte a tomar la mejor decisión de compra en Colombia.
			</p>
		</header>

		<div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				articulos.map((art) => (
					<article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
						<a href={`/guias/${art.slug}`} class="block overflow-hidden bg-graphite aspect-16/10">
							<img
								src={art.imagen}
								alt={art.titulo}
								width="800"
								height="500"
								class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
								loading="lazy"
							/>
						</a>
						<div class="flex flex-1 flex-col p-6">
							<div class="flex items-center justify-between text-xs text-smoke">
								<span class="font-bold uppercase tracking-wider text-gold-deep">{art.categoria}</span>
								<span>{art.lectura}</span>
							</div>
							<a href={`/guias/${art.slug}`} class="mt-3">
								<h2 class="font-serif text-xl font-bold leading-snug text-graphite transition-colors group-hover:text-gold-deep">
									{art.titulo}
								</h2>
							</a>
							<p class="mt-3 text-xs leading-relaxed text-smoke line-clamp-3">
								{art.descripcion}
							</p>
							<div class="mt-auto pt-6">
								<a
									href={`/guias/${art.slug}`}
									class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gold-deep hover:text-gold"
								>
									Leer artículo completo →
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>
</Layout>
