---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
	formatPrice,
	optimizarImagen,
	SITE,
	whatsappLink,
} from "../../lib/site";

export async function getStaticPaths() {
	const productos = await getCollection(
		"products",
		({ data }) => data.activo,
	);
	return productos.map((p) => ({
		params: { slug: p.data.slug },
		props: { producto: p },
	}));
}

interface Props {
	producto: CollectionEntry<"products">;
}

const { producto } = Astro.props;
const p = producto.data;

const relacionados = (
	await getCollection(
		"products",
		({ data }) => data.activo && data.categoria === p.categoria,
	)
)
	.filter((x) => x.data.slug !== p.slug)
	.slice(0, 4);

const descuento =
	p.precioAntes && p.precioAntes > p.precio
		? Math.round(((p.precioAntes - p.precio) / p.precioAntes) * 100)
		: 0;

const mensajeProducto = `Hola ${SITE.name}, quiero información sobre: *${p.nombre}* (${p.categoria} ${p.marca}) — ${formatPrice(p.precio)}, ${SITE.siteUrl}/productos/${p.slug}`;

const imagenes = [p.imagen, ...p.galeria];

// Iconos de la ficha técnica (SVG, sin emojis)
const ICONOS: Record<string, string> = {
	sistema:
		'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="6.5"/><path d="M12 9.5V12l2 1.5"/><path d="M9 2h2M13 2h2M9 22h2M13 22h2"/></svg>',
	material:
		'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>',
	resistencia:
		'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/></svg>',
	funciones:
		'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>',
	diseño: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><path d="M9.5 13.5L8 21l4-3 4 3-1.5-7.5"/></svg>',
	otro: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5z"/><path d="M19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7z"/></svg>',
};
const iconoDe = (etiqueta: string) =>
	ICONOS[etiqueta.toLowerCase()] ?? ICONOS.otro;

const urlProducto = new URL(`/productos/${p.slug}`, SITE.siteUrl);
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: p.nombre,
	image: imagenes.map((i) => new URL(i, SITE.siteUrl).href),
	description: p.descripcion,
	brand: { "@type": "Brand", name: p.marca },
	offers: {
		"@type": "Offer",
		priceCurrency: "COP",
		price: p.precio,
		availability: p.stock
			? "https://schema.org/InStock"
			: "https://schema.org/OutOfStock",
		url: urlProducto.href,
	},
};

const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: new URL("/", SITE.siteUrl).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: p.categoria,
			item: new URL(`/${p.categoria}`, SITE.siteUrl).href,
		},
		{
			"@type": "ListItem",
			position: 3,
			name: p.nombre,
			item: urlProducto.href,
		},
	],
};
---

<Layout
	title={p.nombre}
	description={p.descripcion}
	ogImage={optimizarImagen(p.imagen)}
	type="product"
	canonical={`/productos/${p.slug}`}
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
		<nav
			class="flex flex-wrap items-center gap-1 text-xs text-smoke"
			aria-label="Ruta de navegación"
		>
			<a href="/" class="hover:text-gold-deep">Inicio</a>
			<span>/</span>
			<a href={`/${p.categoria}`} class="capitalize hover:text-gold-deep"
				>{p.categoria}</a
			>
			<span>/</span>
			<span class="text-graphite">{p.nombre}</span>
		</nav>

		<div class="mt-8 grid gap-10 lg:grid-cols-2">
			<!-- Galería -->
			<div>
				<div
					class="overflow-hidden rounded-4xl border border-line bg-graphite"
				>
					<img
						src={optimizarImagen(p.imagen)}
						alt={p.alt}
						width="1200"
						height="1200"
						loading="eager"
						class="aspect-square w-full object-cover"
					/>
				</div>
				{
					imagenes.length > 1 && (
						<div class="mt-4 grid grid-cols-4 gap-3">
							{imagenes.map((img, i) => (
								<button
									type="button"
									class:list={[
										"overflow-hidden rounded-2xl border-2 bg-graphite",
										i === 0
											? "border-gold"
											: "border-transparent hover:border-gold-deep",
									]}
								>
									<img
										src={optimizarImagen(img)}
										alt={`${p.nombre} — vista ${i + 1}`}
										width="1200"
										height="1200"
										loading="lazy"
										class="aspect-square w-full object-cover"
									/>
								</button>
							))}
						</div>
					)
				}
			</div>

			<!-- Información -->
			<div>
				<p
					class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-deep"
				>
					{p.categoria} · {p.marca}
				</p>
				<h1
					class="mt-2 font-serif text-3xl leading-tight text-graphite sm:text-4xl"
				>
					{p.nombre}
				</h1>

				<div class="mt-5 flex flex-wrap items-baseline gap-3">
					<p class="text-3xl font-bold text-graphite">
						{formatPrice(p.precio)}
					</p>
					{
						p.precioAntes && (
							<p class="text-lg text-smoke line-through">
								{formatPrice(p.precioAntes)}
							</p>
						)
					}
					{
						descuento > 0 && (
							<span class="rounded-full bg-gold px-3 py-1 text-xs font-bold text-ink">
								-{descuento}%
							</span>
						)
					}
				</div>

				<p class="mt-2 text-sm">
					{
						p.stock ? (
							<span class="inline-flex items-center gap-2 text-[#2e7d32]">
								<span class="h-2 w-2 rounded-full bg-[#2e7d32]" />{" "}
								Disponible — envío a todo Colombia
							</span>
						) : (
							<span class="text-red-600">
								Agotado — consulta disponibilidad
							</span>
						)
					}
				</p>

				<p class="mt-6 leading-relaxed text-smoke">{p.descripcion}</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<button
						type="button"
						class="js-add-consulta rounded-full bg-graphite px-7 py-3.5 text-sm font-bold text-ivory transition-colors hover:bg-gold-deep"
						data-slug={p.slug}
						data-nombre={p.nombre}
						data-precio={p.precio}
						data-url={`/productos/${p.slug}`}
						data-imagen={optimizarImagen(p.imagen)}
					>
						+ Añadir a consulta
					</button>
					<a
						href={whatsappLink(mensajeProducto)}
						target="_blank"
						rel="noopener"
						class="flex items-center justify-center gap-2 rounded-full bg-[#25d366] px-7 py-3.5 text-sm font-bold text-ink transition-opacity hover:opacity-90"
					>
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
							></path>
						</svg>
						Preguntar por este producto
					</a>
				</div>

				<ul
					class="mt-8 space-y-2.5 border-t border-line pt-6 text-sm text-smoke"
				>
					<li>✓ Garantía en todos los productos</li>
					<li>✓ Envíos seguros a todas las ciudades de Colombia</li>
					<li>
						✓ Asesoría personalizada antes y después de tu compra
					</li>
					<li>✓ Pago coordinado por WhatsApp</li>
				</ul>
			</div>
		</div>

		{
			p.caracteristicas.length > 0 && (
				<div class="mt-16 border-t border-line pt-12">
					<h2 class="font-serif text-2xl text-graphite sm:text-3xl">
						Características
					</h2>
					<dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{p.caracteristicas.map((c) => (
							<div class="flex gap-4 rounded-2xl border border-line bg-white p-5">
								<span
									class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-graphite text-gold"
									aria-hidden="true"
									set:html={iconoDe(c.etiqueta)}
								/>
								<div>
									<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-deep">
										{c.etiqueta}
									</dt>
									<dd class="mt-1 text-sm leading-relaxed text-smoke">
										{c.detalle}
									</dd>
								</div>
							</div>
						))}
					</dl>
				</div>
			)
		}
	</section>

	{
		relacionados.length > 0 && (
			<section class="border-t border-line bg-white">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
					<h2 class="font-serif text-2xl text-graphite sm:text-3xl">
						También te puede interesar
					</h2>
					<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
						{relacionados.map((r) => (
							<ProductCard producto={r} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>
